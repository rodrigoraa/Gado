# Copie para .env e substitua todos os valores marcados como TROQUE.
# Nunca armazene o token do Cloudflare neste arquivo.

COMPOSE_PROJECT_NAME=gestao-rural
APP_VERSION=dev
APP_DOMAIN=gado.seudominio.com.br
APP_BASE_URL=https://gado.seudominio.com.br

DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_SECRET_KEY=TROQUE-por-uma-chave-longa-aleatoria-com-pelo-menos-50-caracteres
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=gado.seudominio.com.br,127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=https://gado.seudominio.com.br
# O padrão é true e muda para false quando ENABLE_LAN_FALLBACK=true.
# DJANGO_SECURE_SSL_REDIRECT=true

# Caminho interno persistente usado pelo volume sqlite_data.
SQLITE_PATH=/app/data/db.sqlite3
SQLITE_TIMEOUT_SECONDS=30

TIME_ZONE=America/Campo_Grande
LANGUAGE_CODE=pt-br
MAX_UPLOAD_BYTES=10485760
PAGINATE_BY=20
GESTACAO_DIAS_PADRAO=283
MARGEM_PARTO_DIAS_PADRAO=7

# O Compose fixa um único worker para reduzir a concorrência de escrita no SQLite.
GUNICORN_TIMEOUT=120
LOG_LEVEL=INFO

# O override LAN só é ativado pelo perfil e comando documentados no README.
ENABLE_LAN_FALLBACK=false
LAN_BIND_ADDRESS=192.168.1.10
LAN_PORT=8080

# Usadas pelos scripts Linux; prefira outro disco ou dispositivo.
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=30
# BACKUP_LOG_FILE=/var/log/gestao-rural/backup.log

# Alertas operacionais executados por `python manage.py verificar_alertas`.
BACKUP_MONITOR_ENABLED=true
BACKUP_MAX_AGE_HOURS=36
# BACKUP_STATUS_FILE=/app/media/.sistema/ultimo_backup.json
DISK_MONITOR_ENABLED=true
DISK_MIN_FREE_PERCENT=10
# DISK_MONITOR_PATH=/app/media

# Crie secrets/cloudflare_tunnel_token.txt com chmod 600 no servidor Linux.
# Não há variável CLOUDFLARE_TUNNEL_TOKEN de propósito.
